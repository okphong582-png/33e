{
  "rules": {
    ".read": false,
    ".write": false,
    "licenses": {
      "$keyHash": {
        ".read": true,
        ".write": false,
        ".validate": "newData.hasChildren(['enabled', 'expiresAt']) && newData.child('enabled').isBoolean() && newData.child('expiresAt').isNumber()"
      }
    }
  }
}
